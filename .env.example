# Gatimaan — Centralized Environment Configuration

# Production Domain (used for Canonical URLs, Open Graph, Sitemap & Robots.txt)
NEXT_PUBLIC_SITE_URL=https://gatimaan.io

# Mobile App Store Availability (leave empty until official store listing is live)
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_IOS_APP_STORE_URL=
NEXT_PUBLIC_APP_VERSION=v1.0 (Enterprise Release)

# Official Company Contact Channels (leave empty if unconfirmed; never invented)
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_COMPANY_PHONE=

# Legal Document Effective Dates & Approved Policy Placeholders
NEXT_PUBLIC_PRIVACY_EFFECTIVE_DATE=November 7, 2026
NEXT_PUBLIC_PRIVACY_LAST_UPDATED=November 7, 2026
NEXT_PUBLIC_APPROVED_TERMS_URL=

# Server-Side Backend Endpoints (Never exposed to client-side bundle)
DELETION_BACKEND_API_URL=
DELETION_BACKEND_API_KEY=
CONTACT_BACKEND_API_URL=
CONTACT_BACKEND_API_KEY=

